# FireCast — example environment file. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is git-ignored). Keys stay in the environment.

# NASA FIRMS map key (free, one per user):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Local LLM (Ollama) used only to narrate already-frozen facts. Optional.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Champion artifact + public target defaults (override only if you relocate data).
CHAMPION_DIR=outputs/champion_climatology_regional_intensity12
PUBLIC_TARGET_PATH=data/snapshots/inpe_monthly_public_v3/events_target_region.csv
PUBLIC_TARGET_SATELLITE=AQUA_M-T
